NVIDIA_API_KEY=
DISCORD_TOKEN=
HERMES_MODEL=nvidia/nemotron-3-super-120b-a12b
ALLOWED_GUILD_ID=
OWNER_USER_ID=
# Teto de tokens de raciocinio por resposta de chat. Mais alto = pensa mais fundo e
# demora mais; 768 e o equilibrio medido em producao.
AI_REASONING_BUDGET=768
# Passadas EXTRAS de autocritica por resposta (cada uma custa +1 chamada). Padrao 0:
# o raciocinio nativo do modelo ja faz esse papel desde ago/2026.
REFINEMENT_ROUNDS=0
# 1 liga uma reescrita final "mais humana" (+1 chamada). Padrao 0.
HUMANIZE_PASS=0
# Perfil publico do AniList usado na curadoria de noticias geek e no radar de anime.
ANILIST_USERNAME=Rizuw
# Quantas chamadas de IA rodam ao mesmo tempo (ai_gate/PriorityGate). Padrao 4 - o teto
# real e a cota da API da NVIDIA (~40 req/min por conta no tier gratuito, nao publicado
# oficialmente); subir demais aumenta risco de 429 em rajada. Ajustar so depois de
# observar RateLimitError real em producao (fica no log como "limite temporario").
AI_CONCURRENCY_LIMIT=4
# Chave da API da Tavily (tavily.com, tier gratuito 1.000 buscas/mes sem cartao) - fonte
# primaria de /pesquisa e da busca automatica no chat. Vazio = continua 100% no scraping
# do DuckDuckGo (fallback automatico mesmo com a chave configurada, se a Tavily cair).
TAVILY_API_KEY=
# ID do canal de texto onde a Solenne manda a mensagem de boas-vindas de novo membro
# (cogs/welcome.py). Vazio/ausente = usa o canal de sistema do proprio servidor
# (Configuracoes do servidor > Boas-vindas e Notificacoes); se nenhum dos dois existir
# ou faltar permissao de enviar, so fica um log.warning, sem travar o bot.
WELCOME_CHANNEL_ID=

# Ponte com o site (site_noticias.py). O resumo diario de noticias tambem e gravado
# como arquivo no repositorio do site, que recompila sozinho no Cloudflare Pages.
# Vazio = desligado, o resumo continua indo so pro Discord.
#
# O token precisa ser fine-grained, com acesso SO a esse repositorio e permissao
# "Contents: Read and write". Nao use token classico com escopo repo inteiro: se
# vazar, ele alcanca tudo que a conta tem.
SITE_REPO=luizhc06/MeuSite
SITE_REPO_TOKEN=
# Caminho do arquivo dentro do repositorio. So mude se mover no site.
SITE_ARQUIVO=src/data/noticias.json
