NVIDIA_API_KEY=
DISCORD_TOKEN=
HERMES_MODEL=nvidia/nemotron-3-super-120b-a12b
ALLOWED_GUILD_ID=
OWNER_USER_ID=
# Teto de tokens de raciocinio por resposta de chat. Mais alto = pensa mais fundo e
# demora mais; 768 e o equilibrio medido em producao.
AI_REASONING_BUDGET=768
# Passadas EXTRAS de autocritica por resposta (cada uma custa +1 chamada). Padrao 0:
# o raciocinio nativo do modelo ja faz esse papel desde ago/2026.
REFINEMENT_ROUNDS=0
# 1 liga uma reescrita final "mais humana" (+1 chamada). Padrao 0.
HUMANIZE_PASS=0
# Perfil publico do AniList usado na curadoria de noticias geek e no radar de anime.
ANILIST_USERNAME=Rizuw
# Quantas chamadas de IA rodam ao mesmo tempo (ai_gate/PriorityGate). Padrao 4 - o teto
# real e a cota da API da NVIDIA (~40 req/min por conta no tier gratuito, nao publicado
# oficialmente); subir demais aumenta risco de 429 em rajada. Ajustar so depois de
# observar RateLimitError real em producao (fica no log como "limite temporario").
AI_CONCURRENCY_LIMIT=4
